# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL / Prisma ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived on purpose: the refresh flow (httpOnly cookie, see below) silently
# renews this. A short window bounds the damage if an access token ever leaks.
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-to-another-long-random-string
REFRESH_EXPIRY=7d
# Context-switched tokens (e.g. role escalation) get a shorter expiry:
JWT_CONTEXT_EXPIRES_IN=30m

# ─── Refresh token cookie ──────────────────────────────────────────────────────
# The refresh token is set as an httpOnly cookie (never readable from JS / localStorage).
# 'lax' works when frontend + API share a registrable domain (subdomains) or run on
# localhost with different ports. Use 'strict' for same-site-only flows, or 'none'
# (requires HTTPS — cookie.secure is forced true outside development) when the
# frontend and API are on fully unrelated origins.
REFRESH_COOKIE_SAMESITE=lax

# ─── CORS / Frontend ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Vite dev server by default). Must be an
# explicit list, never "*" — credentialed (cookie) CORS requests require it.
FRONTEND_URL=http://localhost:5173

# ─── Reverse proxy ─────────────────────────────────────────────────────────────
# Number of proxy hops to trust for req.ip (1 = direct behind ALB/nginx).
# Critical: rate limiters + audit logs key on req.ip. Set 0 for direct internet.
TRUST_PROXY=1

# ─── Super Admin bootstrap ─────────────────────────────────────────────────────
# Gate for `npm run create:superadmin` (interactive CLI)
SUPER_ADMIN_SECRET=change-me

# ─── Email (SMTP) — required for password reset OTP emails ─────────────────────
# If SMTP_HOST is left unset, emails are printed to the server log in DEV mode
# and are NOT delivered. Configure before going to production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# ─── AWS S3 ────────────────────────────────────────────────────────────────────
S3_USER_ACCESS_KEY=
S3_USER_SECRET=
BUCKET_REGION=ap-south-1
S3_BUCKET_NAME=

# ─── Email fallback ─────────────────────────────────────────────────────────────
# Used as SMTP_FROM fallback if SMTP_* vars are unset
SUPPORT_EMAIL=support@yourdomain.com

# ─── Cloudinary (image/asset CDN) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payment — Stripe (billing module: modules/billing) ────────────────────────
# STRIPE_SECRET_KEY     — server-side API key. Use the sk_test_... key outside
#                         production; NEVER commit a live key.
# STRIPE_WEBHOOK_SECRET — the signing secret for the webhook ENDPOINT, shown when
#                         you create it in the Stripe dashboard (or printed by
#                         `stripe listen` in local development). It is per-endpoint,
#                         so test and production have different values. Without it
#                         POST /api/v1/webhooks/stripe rejects every delivery.
# Both are read lazily, so the app boots fine without them — only billing calls fail.
#
# Local webhook testing:  stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
#
# Plan → Stripe price mapping lives in the DATABASE, not here: set Plan.stripePriceId
# per environment (the migration seeds the plan catalogue with NULL price ids).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payment — Razorpay (plugin slot; omit if not using Razorpay) ───────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── SMS / WhatsApp — Twilio (plugin slot; omit if not using Twilio) ────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
