// Base Prisma schema for the SaaS framework.
// Contains only the models required by the framework's own code (auth, audit, job queue).
// Add your product's domain models below the "── Product Models ──" marker.
//
// After editing:
//   npm run gen:migration add_<description>   (development)
//   npm run migrate:deploy                     (production/CI)

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Framework Models ──────────────────────────────────────────────────────────

model User {
  id                   String         @id @default(cuid())
  userName             String         @unique
  email                String?        @unique
  phone                String?
  password             String
  name                 String
  role                 String
  accessLevel          String         @default("read_write")
  active               Boolean        @default(true)
  isDeleted            Boolean        @default(false)
  tokenVersion         Int            @default(0)
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Per-category email opt-out for notifications (see
  // backend/modules/notifications/notificationCategories.js). JSON, not a
  // dedicated table — a handful of boolean flags per user doesn't earn a join.
  notificationPreferences Json        @default("{}")

  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  memberships          Membership[]
  invitationsSent      Invitation[]   @relation("InvitationsSent")
  filesUploaded        File[]
  notifications        Notification[]
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  revoked    Boolean  @default(false)
  expiredAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiredAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  userId         String?
  userName       String?
  userRole       String?
  ipAddress      String?
  userAgent      String?
  // Nullable: plenty of audit events (login/logout, password reset) are not
  // org-scoped. SET NULL on org delete — the AuditLog row is deliberately the
  // surviving record of an organization's deletion (see OrganizationService's
  // deleteOrganization comment), so it must outlive the FK target.
  organizationId String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
}

// ── Multi-tenancy (Organization / Membership / Invitation) ────────────────────
//
// TENANCY CONTRACT — read before adding any product model:
//
//   Any tenant-owned model MUST include `organizationId String` with an index and
//   a FK to Organization, and EVERY Prisma query against it MUST filter by it.
//   Use `scopedWhere(req, extra)` from backend/helpers/tenantScope.js so the
//   filter cannot be forgotten; `req.organizationId` is populated by
//   backend/middleware/tenantContext.js. There is deliberately no Prisma
//   extension auto-injecting the filter — see tenantScope.js for why.
//
//   A user may belong to MANY organizations. There is NO server-side "current
//   organization": the active org is resolved per request (route param `:orgId`,
//   else the `X-Organization-Id` header), never from sticky session state.

enum OrganizationStatus {
  active
  suspended
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum MembershipStatus {
  active
  invited
  removed
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)
  // Branding — real columns, not `settings`, because these are likely to be
  // queried/indexed-on-existence later (e.g. "orgs with a logo set"). Actual
  // file upload is out of scope here (A07/file-service); a client uploads to
  // that service (or an external image host) and passes back the URL.
  // INTEGRATION POINT for A07: once a file-service exists, logoUrl can be
  // populated from its upload response — no schema change needed here.
  logoUrl      String?
  primaryColor String?
  // Ad-hoc, product-specific config (branding extras, feature toggles, ...)
  // that doesn't need its own migration. CONVENTION: a field goes in a real
  // column when it's structural or queried/filtered on; it goes in `settings`
  // when it's extensible, product-specific config nobody needs to query by.
  settings  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  files         File[]
  notifications Notification[]
  auditLogs     AuditLog[]
  subscription  Subscription?
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole   @default(member)
  status         MembershipStatus @default(active)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One row per (user, org). Role changes edit this row in place — never insert a
  // second membership. Removal sets status='removed' (audit/history matters), so
  // a re-invite reactivates the same row rather than creating a duplicate.
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Invitation {
  id              String         @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole @default(member)
  // Named tokenHash, not token, to match RefreshToken: the raw opaque token
  // (randomBytes(48)) is emailed once and NEVER stored.
  tokenHash       String         @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  // At most one PENDING invitation per (org, email) is enforced by a PARTIAL
  // unique index that Prisma's schema language cannot express — it lives as raw
  // SQL in migrations/*_add_organizations_and_memberships/migration.sql
  // ("Invitation_org_email_pending_key"). If `prisma migrate dev` ever emits a
  // DROP for it, re-add it: the app-level pre-check in OrganizationService is a
  // nicer error message, not a concurrency guarantee.
  @@index([organizationId])
  @@index([tokenHash])
}

// ── Notifications ──────────────────────────────────────────────────────────────
//
// One Notification row = one logical, per-user notification (the in-app inbox
// record). It is NOT split into a separate per-channel delivery-log table:
// today there are only two channels (in_app, email), in_app "delivery" IS the
// row existing, and email delivery is at most a single attempt worth tracking
// (retries live in the job queue's own attempt counter, not here) — so a
// `emailDeliveredAt` / `emailDeliveryError` pair of columns on this row covers
// it without the join a real delivery-log table would force on every list
// query. Revisit if a notification ever needs >1 email attempt tracked
// individually (e.g. digest re-sends) — that's when the second table earns
// its keep.
//
// `type` is a free-form extensible string (see notificationCategories.js for
// the type → category grouping used for email opt-out), not a Prisma enum,
// so new modules can introduce new notification types without a migration.
model Notification {
  id                 String    @id @default(cuid())
  userId             String
  // Optional org context (e.g. "you were invited to X"). Nullable FK, ON DELETE
  // SET NULL — a notification about a since-deleted org should still be visible
  // in the recipient's inbox history, just without a live org to link back to.
  organizationId     String?
  type               String
  title              String
  body               String
  data               Json?
  // Which channel(s) this notification was meant for. Defaults to in_app only;
  // NotificationService.notify() adds 'email' when the type/category calls for
  // it and the recipient hasn't opted out.
  channels           String[] @default(["in_app"])
  readAt             DateTime?
  emailDeliveredAt   DateTime?
  emailDeliveryError String?
  createdAt          DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([organizationId])
}

// ── Billing (Plan / Subscription / ProcessedWebhookEvent) ────────────────────
//
// Stripe is the PAYMENT system of record: full invoice/charge history, proration
// maths and dunning all live there and are NOT mirrored here. These tables hold
// only what the app must answer synchronously on every request — "which plan is
// this org on, and is it paying?" — so an entitlement check never makes a
// network call to stripe.com.
//
// `status` deliberately reuses STRIPE'S OWN vocabulary (trialing/active/past_due/
// canceled/incomplete). Webhook handling is then a direct copy of
// `subscription.status`, not a translation table that drifts the first time
// Stripe adds a state.

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

model Plan {
  id                String  @id @default(cuid())
  // The stable identifier application code branches on ('free', 'pro', …).
  // Code must NEVER branch on Plan.id (cuid, differs per environment) or on
  // stripePriceId (rotates whenever pricing changes in the Stripe dashboard).
  key               String  @unique
  name              String
  priceMonthlyCents Int     @default(0)
  // Null for the free plan — there is nothing to check out.
  stripePriceId     String?
  // feature-key → limit (Int) or capability (Bool), e.g.
  //   { "maxMembers": 5, "maxFiles": 100, "apiAccess": false }
  // A Json blob rather than a Feature/PlanFeature join: plan contents change by
  // editing a row, and no query ever filters or joins ON a feature.
  // Convention: a numeric limit of -1 means unlimited (see helpers/entitlements.js).
  features          Json     @default("{}")
  createdAt         DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  // Unique: exactly ONE row per organization, UPDATED in place as the status
  // changes. Subscription history is not modelled here — Stripe keeps it, and a
  // local append-only mirror would need its own "which row is current?" logic
  // for no gain. Every org has a row (free plan) from the moment it is created,
  // so entitlement lookups never have to cope with "no subscription yet".
  organizationId String             @unique
  planId         String
  stripeCustomerId     String?
  stripeSubscriptionId String?      @unique
  status         SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  // Out-of-order webhook watermark: the `created` timestamp of the newest Stripe
  // event already applied to this row. Stripe does not guarantee delivery order,
  // so a retried older event can arrive after a newer one — without this, a
  // redelivered `past_due` would clobber an `active` the org already paid for.
  lastEventAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([stripeCustomerId])
}

model ProcessedWebhookEvent {
  // Stripe's own event id (evt_...) as the PK — the insert IS the idempotency
  // claim: a duplicate delivery hits the primary-key conflict and is skipped
  // without ever reaching the handler. Chosen over a Redis SET because
  // "exactly once" must survive a Redis flush, and because the claim has to be
  // in the SAME transaction as the state change it guards.
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ── Product Models ────────────────────────────────────────────────────────────
// Add your domain-specific models here.
// Use `npm run gen:model ModelName field:Type` to scaffold a new model.

// ── Files (tenant-owned object storage metadata) ───────────────────────────────
//
// File rows are metadata only — the actual bytes live in S3 under `storageKey`,
// namespaced `orgs/<organizationId>/<fileId>/<sanitized-filename>` (defense in
// depth on top of the DB-level organizationId check; see helpers/fileStorage.js
// and modules/files/services/FileService.js). `storageKey` is an internal
// implementation detail — routes must never return it to the client, only
// short-lived signed download URLs.
//
// Soft delete (status='deleted' + deletedAt): audit/billing may need historical
// usage, so a deleted row survives; the underlying S3 object is removed
// synchronously by FileService.deleteFile.

enum FileStatus {
  active
  deleted
}

model File {
  id               String     @id @default(cuid())
  organizationId   String
  uploadedByUserId String
  filename         String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  status           FileStatus @default(active)
  createdAt        DateTime   @default(now())
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}
