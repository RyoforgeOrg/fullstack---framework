{
  "name": "saas-framework-backend",
  "version": "1.0.0",
  "description": "Reusable SaaS backend scaffold — rename 'name' when bootstrapping a new product",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"tests/*.test.js\"",
    "gen:module": "node scripts/generateModule.js",
    "gen:model": "node scripts/generateModel.js",
    "gen:migration": "node scripts/generateMigration.js",
    "migrate:deploy": "node scripts/deployMigration.js",
    "create:superadmin": "node scripts/createSuperAdmin.js",
    "gen:postman": "node scripts/generatePostman.js",
    "lint": "node scripts/lintCheck.js",
    "test:integration": "node --test --test-concurrency=1 \"tests/*.integration.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.10",
    "otp-generator": "^4.0.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pm2": "^7.0.4",
    "prisma": "7.9.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.8.2",
    "stripe": "^22.6.2",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "puppeteer": "^25.2.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "puppeteer@25.5.0": true
  }
}
