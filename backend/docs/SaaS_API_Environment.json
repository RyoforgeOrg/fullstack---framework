{
  "id": "saas-framework-env",
  "name": "SaaS API Environment",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "enabled": true
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "enabled": true
    },
    {
      "key": "authToken",
      "value": "your-jwt-token-here",
      "enabled": true
    },
    {
      "key": "id",
      "value": "replace-with-a-real-id",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}